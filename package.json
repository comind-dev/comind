{
  "name": "@comind-dev/comind",
  "version": "0.0.1-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Makes one developer's Claude Code setup the whole team's. Pins the toolchain, gates the writes that would drift, and commits the shared context so a fresh clone already has it.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://comind-dev.github.io/comind/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comind-dev/comind.git"
  },
  "bugs": {
    "url": "https://github.com/comind-dev/comind/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "comind": "bin/comind.js"
  },
  "files": [
    "bin/",
    "lib/",
    "commands/",
    "templates/",
    "versions.json",
    "ONBOARDING.md",
    "UPGRADING.md",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "ai",
    "context-engineering",
    "token-optimization",
    "spec-driven-development",
    "knowledge-graph",
    "lsp",
    "obsidian",
    "team"
  ],
  "scripts": {
    "prepublishOnly": "node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "init": "node bin/comind.js",
    "doctor": "node bin/comind.js doctor"
  }
}
